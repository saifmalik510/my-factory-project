{
  "info": {
    "name": "Abdullah Marble Factory API Collection",
    "_postman_id": "abdullah-marble-factory-api-v1",
    "description": "Complete REST API collection for Abdullah Marble Factory (Public Endpoints & Protected Admin Endpoints).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Public APIs",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Get Products (with Filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?category=all&finish=Polished&search=White&page=1&limit=12&sort=featured",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "category", "value": "all" },
                { "key": "finish", "value": "Polished" },
                { "key": "search", "value": "White" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" },
                { "key": "sort", "value": "featured" }
              ]
            }
          }
        },
        {
          "name": "Get Single Product",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/prod-1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "prod-1"]
            }
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Get Gallery Items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/gallery",
              "host": ["{{baseUrl}}"],
              "path": ["gallery"]
            }
          }
        },
        {
          "name": "Get Public Site Settings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/settings",
              "host": ["{{baseUrl}}"],
              "path": ["settings"]
            }
          }
        },
        {
          "name": "Submit Contact Inquiry / Quotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tariq Mehmood\",\n  \"phone\": \"+92 300 8765432\",\n  \"email\": \"tariq@example.com\",\n  \"inquiryType\": \"Quotation Request\",\n  \"productInterest\": \"Ziarat White Classic\",\n  \"preferredFinish\": \"Polished\",\n  \"dimensions\": \"24x24 tiles\",\n  \"quantity\": \"1200 sq ft\",\n  \"message\": \"Need pricing with delivery to Fort Abbas.\",\n  \"website\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inquiries",
              "host": ["{{baseUrl}}"],
              "path": ["inquiries"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Verify Me (JWT)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Admin Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Protected Admin APIs",
      "item": [
        {
          "name": "Get Dashboard Overview Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard-stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dashboard-stats"]
            }
          }
        },
        {
          "name": "Get All Admin Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/products",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products"]
            }
          }
        },
        {
          "name": "Create Product (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Onyx Gold Translucent\",\n  \"category\": \"Onyx & Exotic\",\n  \"description\": \"Semi-precious stone suitable for backlighting.\",\n  \"finish\": [\"Polished\"],\n  \"size\": [\"Custom Slabs\"],\n  \"application\": [\"Wall Cladding\", \"Decorative\"],\n  \"availability\": \"In Stock\",\n  \"isFeatured\": true,\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/products",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products"]
            }
          }
        },
        {
          "name": "Toggle Product Visibility",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/products/prod-1/toggle-status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products", "prod-1", "toggle-status"]
            }
          }
        },
        {
          "name": "Get Admin Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "categories"]
            }
          }
        },
        {
          "name": "Get Admin Inquiries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/inquiries?status=All",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "inquiries"],
              "query": [{ "key": "status", "value": "All" }]
            }
          }
        },
        {
          "name": "Update Inquiry Status & Notes",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Quoted\",\n  \"adminNotes\": \"Quotation for 1200 sq ft sent on WhatsApp at PKR 450/sq ft.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/inquiries/inq-01/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "inquiries", "inq-01", "status"]
            }
          }
        },
        {
          "name": "Get Full Admin Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/settings",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "settings"]
            }
          }
        },
        {
          "name": "Update Site Settings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"factoryName\": \"Abdullah Marble Factory\",\n  \"contact\": {\n    \"phone\": \"+92 300 8765432\",\n    \"whatsapp\": \"+92 300 8765432\",\n    \"email\": \"info@abdullahmarble.com\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/settings",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "settings"]
            }
          }
        }
      ]
    }
  ]
}
